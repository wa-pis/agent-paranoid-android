        },
        "oneOf": [
          {
            "$ref": "#/$defs/ConditionalRequiredRule"
          },
          {
            "$ref": "#/$defs/ConditionalAllowedValuesRule"
          },
          {
            "$ref": "#/$defs/TemporalOrderingRule"
          },
          {
            "$ref": "#/$defs/FormulaRule"
          }
        ]
      },
      "maxItems": 1000,
      "title": "Row Rules",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioRule"
      },
      "maxItems": 1000,
      "title": "Scenarios",
      "type": "array"

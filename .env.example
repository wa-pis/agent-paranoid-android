TRINO_HOST=trino.example.internal
TRINO_PORT=443
TRINO_USER=your_user
TRINO_HTTP_SCHEME=https
TRINO_AUTH_METHOD=none
# For Basic auth, select basic and reference a separately supplied environment secret:
# TRINO_AUTH_METHOD=basic
# TRINO_AUTH_SECRET_ENV=MY_TRINO_PASSWORD
# Supply MY_TRINO_PASSWORD outside this file; never store credentials here.
TRINO_ALLOWED_CATALOGS=hive,iceberg
TRINO_ALLOWED_SCHEMAS=dev,test,staging

# Generator MCP deadline; restart the server after changing it.
TEST_DATA_AGENT_MCP_MAX_INVOCATION_SECONDS=120
